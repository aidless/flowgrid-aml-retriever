AML_DENSE_MODEL=
AML_DENSE_THREADS=
AML_NOMIC_MODEL=
AML_INCLUDE_PROVENANCE=

# ---- 功能开关（测试与消融用）----
AML_FLAG_DENSE_NOMIC=
AML_FLAG_FACT_EXTRACTION=

# ---- 压测脚本（loadtest/）----
FLOWGRID_SEARCH_PATH=
FLOWGRID_USER_ID=
TEMPORAL_MUTATION_PATH=
STRICT_QUERY_HEADER=
