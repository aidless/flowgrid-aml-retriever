# --- deployment variables (read by docker-compose.yml, not by the Python code) ---
# read at docker-compose.yml:32 — host port the container publishes (container side stays 8080)
AML_HOST_PORT=8080

# read at docker-compose.yml:42 — auth scheme: bearer | token | x-api-key
AML_AUTH_MODE=bearer

# read at docker-compose.yml:43 — required by compose; the official evaluation needs a real credential on Add/Search
AML_API_KEY=

# read at docker-compose.yml:47 — HTTP path of the add endpoint
AML_ADD_PATH=/add

# read at docker-compose.yml:48 — HTTP path of the search endpoint
AML_SEARCH_PATH=/search

# read at docker-compose.yml:49 — HTTP path of the health endpoint
AML_HEALTH_PATH=/health

# read at docker-compose.yml:53 — read-connection pool size
AML_POOL_SIZE=24

# read at docker-compose.yml:54 — sqlite busy timeout in milliseconds
AML_BUSY_TIMEOUT_MS=10000

# read at docker-compose.yml:62 — secret for the fact-extraction provider; only used when AML_FLAG_FACT_EXTRACTION=1
SC_API_KEY=

# read at docker-compose.yml:63 — base URL for the fact-extraction provider
SC_API_BASE=https://api.scnet.cn/v1

